{
  "name": "alo-print-agent",
  "version": "2.0.0",
  "private": true,
  "description": "ALO Kiosk Print Connector",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node src/index.js",
    "app": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "ch.alokiosk.printconnector",
    "productName": "ALO Print Connector",
    "files": [
      "electron/**/*",
      "ui/**/*",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  }
}
